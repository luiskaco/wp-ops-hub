# =============================================================================
# Gitignore para Repositorio de Plugins y Utilidades de WordPress
# =============================================================================

# Ignorar todo por defecto
/*

# Excepciones que SI se versionan
!/.gitignore
!/README.md
!/README.es.md
!/AGENTS.md
!/CLAUDE.md
!/.agents/
!/.claude/
/.claude/settings.local.json
!/LICENSE
!/docs/
!/docs/**
!/plugins/
!/plugins/**
!/tests/
!/tests/**
!/.github/
!/.github/**

# Basura del sistema y editores
.DS_Store
Thumbs.db
*.log
*.tmp
*.wpress
*.tar.gz
*.zip
.idea/
.vscode/
/node_modules/
/vendor/
